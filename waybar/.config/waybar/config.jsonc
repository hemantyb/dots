{
	"layer": "top",
	"position": "right",
	"mod": "dock",
	"exclusive": true,
	"passthrough": false,
	"gtk-layer-shell": true,
	"swap-icon-label": false,
	"modules-left": [
		"niri/workspaces",
	],
	"modules-center": [
		"clock"
	],
	"modules-right": [
		"network",
		"battery",
		"backlight",
		"pulseaudio"
	],
	"niri/workspaces": {
		"format": "{icon}",
		"format-icons": {
			"default": "",
			"active": ""
		}
	},
	"clock": {
		"timezone": "Asia/Kolkata",
		"tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
		"format": "{:%d\n%m\n-\n%I\n%M\n}",
    "justify": "center",
		"interval": 1
	},
	"network": {
		"format-wifi": " ",
		"format-ethernet": "󰈀",
    "justify": "center",
		"interval": 5,
		"tooltip": false,
		"tooltip-format": "{essid} - {ifname} via {gwaddr}",
		"format-disconnected": "⚠",
	},
	"battery": {
		"states": {
			"good": 95,
			"warning": 40,
			"critical": 30
		},
		"format": "{icon}\n{capacity}",
		"format-charging": "\n{capacity}",
		"format-plugged": "\n{capacity}",
		"format-alt": "{time}\n{icon}",
    "justify": "center",
		"format-icons": [
			"󰂎",
			"󰁺",
			"󰁻",
			"󰁼",
			"󰁽",
			"󰁾",
			"󰁿",
			"󰂀",
			"󰂁",
			"󰂂",
			"󰁹"
		]
	},
    "backlight": {
    "format": "{icon}\n{percent}",
    "format-icons": ["", "", "", "", "", "", "", "", ""],
    "tooltip": false,
    "justify": "center",
    "reverse-scrolling": true,
		"on-scroll-up": "brightnessctl -q set 1%+",
		"on-scroll-down": "brightnessctl -q set 1%-"
    },
	"pulseaudio": {
		"format": "{icon}\n{volume}",
		"tooltip": false,
    "justify": "center",
		"format-muted": "",
		"on-click": "pamixer -t",
		"on-scroll-up": "pamixer -i 5",
		"on-scroll-down": "pamixer -d 5",
		"scroll-step": 100,
		"format-icons": {
			"headphone": " ",
			"default": [
				"",
				"",
				""
			]
		}
	}
}
